{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "FUENTE ÚNICA de verdad de neo-ui. W3C Design Tokens. El build deriva theme.css (@theme), tokens.pptx.json y docs. NUNCA editar los artefactos generados a mano.",

  "color": {
    "$type": "color",
    "$description": "Paleta NEO. Solo estos tokens generan utilidades (bg-neo-*, text-neo-*). Componentes usan var(--neo-*).",

    "neo-navy":        { "$value": "#000033", "$description": "Primaria. Fondos oscuros: solo portada, divisor, cierre." },
    "neo-navy-mid":    { "$value": "#0A0A5C", "$description": "Variante para gradientes / secciones." },
    "neo-navy-light":  { "$value": "#1A1A8C", "$description": "Superficie oscura secundaria." },
    "neo-blue":        { "$value": "#05058C", "$description": "Acento · KPI · CTA. NUNCA sobre navy." },
    "neo-blue-light":  { "$value": "#9DB0FF", "$description": "Acento SOBRE navy." },
    "neo-violet":      { "$value": "#6E6EB9", "$description": "Terciario · acento suave." },
    "neo-white":       { "$value": "#FFFFFF" },
    "neo-lila":        { "$value": "#F4F2FA", "$description": "Card suave / fondo modo mixto." },
    "neo-cell":        { "$value": "#DCDCFF", "$description": "Celdas de tabla / gantt activas." },
    "neo-peach":       { "$value": "#F5E6D0", "$description": "Highlight cards / diagramas de proceso." },

    "neo-text-secondary": { "$value": "#4A4A6A" },
    "neo-border":         { "$value": "#D0D0E0" },
    "neo-row-alt":        { "$value": "#F8F8FC" },
    "neo-success":        { "$value": "#2ECC71" },
    "neo-danger":         { "$value": "#E74C3C" },

    "client-color":       { "$value": "#05058C", "$description": "Color de marca del cliente (OPCIONAL). Default = navy NEO." }
  },

  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["PT Serif", "Georgia", "Times New Roman", "serif"], "$description": "Títulos. PT Serif Bold." },
    "body":    { "$value": ["Montserrat", "Helvetica Neue", "Arial", "sans-serif"], "$description": "Cuerpo." }
  },

  "text": {
    "$description": "Escala tipográfica FIJA para canvas 1920×1080. Genera utilidades text-hero/h1/h2/... Nada de font-sizes sueltos.",
    "hero":    { "$value": "112px", "$type": "dimension", "$extensions": { "neo": { "lineHeight": "1.02", "letterSpacing": "-0.015em", "fontWeight": "700" } } },
    "h1":      { "$value": "74px",  "$type": "dimension", "$extensions": { "neo": { "lineHeight": "1.06", "letterSpacing": "-0.01em", "fontWeight": "700" } } },
    "h2":      { "$value": "56px",  "$type": "dimension", "$extensions": { "neo": { "lineHeight": "1.1", "fontWeight": "700" } } },
    "callout": { "$value": "34px",  "$type": "dimension", "$extensions": { "neo": { "lineHeight": "1.35" } } },
    "lead":    { "$value": "28px",  "$type": "dimension", "$extensions": { "neo": { "lineHeight": "1.5" } } },
    "body":    { "$value": "21px",  "$type": "dimension", "$extensions": { "neo": { "lineHeight": "1.55" } } },
    "body-sm": { "$value": "18px",  "$type": "dimension", "$extensions": { "neo": { "lineHeight": "1.55" } } },
    "eyebrow": { "$value": "15px",  "$type": "dimension", "$extensions": { "neo": { "lineHeight": "1.2", "letterSpacing": "0.16em", "fontWeight": "600" } } }
  },

  "space": {
    "$type": "dimension",
    "$description": "Escala de marca (base 4px). Safelist de gap/p/m se acota a este subset.",
    "gutter": { "$value": "100px", "$description": "Margen del slide (canvas)." },
    "4":  { "$value": "16px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },

  "radius": {
    "$type": "dimension",
    "sm":   { "$value": "8px" },
    "md":   { "$value": "12px" },
    "lg":   { "$value": "16px" },
    "xl":   { "$value": "22px" },
    "pill": { "$value": "999px" }
  },

  "canvas": {
    "$type": "dimension",
    "$description": "Dimensiones del slide. Inmutables: formato 16:9 a 1920×1080.",
    "w": { "$value": "1920px" },
    "h": { "$value": "1080px" }
  }
}
