# Qué NO se sube a Cloud Build. Explícito a propósito: sin este archivo gcloud deriva
# uno de .gitignore, y ahí están ignoradas las copias pinneadas (dist/neo-ui@*.css) que
# scripts/deploy.sh genera justo antes del deploy — quedarían fuera de la imagen.
.git/
.gitignore
.gitattributes
node_modules/
samples/
tests/
*.log
